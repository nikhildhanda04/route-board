{
  "name": "school-bus-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/apply-migration.mjs",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:verify": "tsx --env-file=.env.local scripts/verify.ts",
    "check:sms": "tsx scripts/check-sms.ts",
    "check:flow": "tsx --env-file=.env.local scripts/check-flow.ts",
    "outbox": "tsx --env-file=.env.local scripts/show-outbox.ts",
    "db:reset": "npm run db:seed && npm run db:verify",
    "db:setup-roles": "psql \"$(grep MIGRATE_DATABASE_URL .env.local | cut -d= -f2-)\" -f scripts/setup-roles.sql",
    "form:doc": "node scripts/onboarding-doc.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:gps": "tsx scripts/check-gps.ts",
    "check:city": "tsx scripts/check-city.ts",
    "check:routing": "tsx scripts/check-routing.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
